{
  "name": "solo-x",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/web",
    "packages/sdk"
  ],
  "scripts": {
    "dev": "npm run dev -w @solo-x/web",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build -w @solo-x/sdk && npm run build -w @solo-x/web",
    "test": "npm run build -w @solo-x/sdk && npm run test --workspaces"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3"
  }
}
